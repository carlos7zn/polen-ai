{
  "functions": {
    "api/*.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/register",
      "destination": "/api/register.js"
    },
    {
      "source": "/api/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/conversations.js"
    }
  ],
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null
}