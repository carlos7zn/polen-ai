# Copia este archivo a .env (local) y rellena los valores.
# En Vercel: Settings -> Environment Variables.  NUNCA subas .env a GitHub.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta/service_role de Supabase (SOLO en el servidor, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Codigo de invitacion para registrarse (dalo solo a tus amigos). Si lo dejas vacio, cualquiera puede registrarse.
INVITE_CODE=

# LLM (cualquier endpoint compatible con OpenAI: FreeLLMAPI, Hermes, OpenRouter...)
LLM_BASE_URL=https://URL-DE-TU-TUNEL/v1
LLM_API_KEY=
LLM_MODEL=
# SYSTEM_PROMPT=Eres PolenAI, un asistente util. Responde en el idioma del usuario.
